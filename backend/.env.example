# ==========================================
# ResearchGraph Environment Configuration
# ==========================================

# Academic API Integrations (Research Discovery Hub)

# OpenAlex (Primary Search Provider)
# Base API URL (defaults to https://api.openalex.org)
OPENALEX_API_URL=https://api.openalex.org
# Optional API key for higher rate limits (supports keyless requests if omitted)
OPENALEX_API_KEY=your_openalex_api_key_here

# Crossref (Metadata Verification and Enrichment)
# Base API URL (defaults to https://api.crossref.org)
CROSSREF_API_URL=https://api.crossref.org
# Contact email for Crossref Polite Pool rate limits and headers
CROSSREF_MAILTO=your_email@example.com

# Unpaywall (Open Access DOI Resolution)
# Base API URL (defaults to https://api.unpaywall.org)
UNPAYWALL_API_URL=https://api.unpaywall.org
# Required email address for Unpaywall v2 API access
UNPAYWALL_EMAIL=your_email@example.com

# Future Academic Providers (Preserved for future development - not yet integrated)
DOAJ_API_URL=https://doaj.org/api
CORE_API_URL=https://api.core.ac.uk/v3
CORE_API_KEY=your_core_api_key_here

# Hugging Face Models (Preserved for future extensions)
HUGGINGFACE_API_KEY=your_hf_api_key_here
HF_MULTILINGUAL_MODEL_URL=
HF_BGE_SMALL_MODEL_URL=
